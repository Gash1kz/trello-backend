# Окружение приложения (development / production)
APP_ENV=development

# Ключ шифрования конфигурационных значений (AES-256-GCM)
# Генерируется командой: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=change-this-to-a-32-byte-base64-key

# HTTP порт приложения
APP_PORT=8080

# Подключение к PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trello
DB_USERNAME=trello
DB_PASSWORD=trello_password

# Настройки логирования
LOG_CHANNEL=app
LOG_LEVEL=debug
LOG_BODY_MAX_BYTES=0
