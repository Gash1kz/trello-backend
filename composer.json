{
    "name": "sortix/trello-backend",
    "description": "Учебный бэкенд доски задач (Trello-клон) на PHP + PostgreSQL + Eloquent + Monolog",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/filesystem": "^12.0",
        "monolog/monolog": "^3.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
